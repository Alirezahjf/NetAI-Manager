# ==========================
# NetAI Manager - Environment
# ==========================

APP_NAME=NetAI-Manager
APP_VERSION=0.1.0
SECRET_KEY=please-change-this-to-a-long-random-string
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ---------- AI Engine ----------
# Providers: ollama | openai | openai-compatible
AI_PROVIDER=ollama
AI_MODEL=llama3.2
AI_SYSTEM_PROMPT=You are a helpful, professional assistant that helps manage social accounts. Always reply in the same language as the user message. Be concise and natural.

OLLAMA_BASE_URL=http://localhost:11434

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- Telegram ----------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=netai_telegram

# ---------- Bale ----------
BALE_BOT_TOKEN=
# or user-mode credentials if using unofficial client

# ---------- Soroush (via SoroPy) ----------
# Prefer runtime login; do not hardcode phone numbers in production
SOROUSYH_DEFAULT_BACKEND=websocket

# ---------- Email ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
EMAIL_USER=
EMAIL_PASSWORD=

# ---------- YouTube ----------
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_SECRETS_FILE=

# ---------- Security ----------
# Comma-separated origins for CORS if needed
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
