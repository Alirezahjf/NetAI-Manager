# ==========================
# NetAI Manager - Environment
# ==========================

APP_NAME=NetAI-Manager
APP_VERSION=0.2.0
SECRET_KEY=please-change-this-to-a-long-random-string
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ---------- AI Engine (اول AI / AvalAI) ----------
# Default provider is AvalAI — only set the API key from dashboard:
# https://avalai.ir  →  Developers → API Keys
AI_PROVIDER=avalai
AI_MODEL=gpt-4o-mini
AI_SYSTEM_PROMPT=You are a helpful, professional assistant that helps manage social accounts. Always reply in the same language as the user message. Be concise and natural.

AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
# Optional in-country mirror: https://api.avalapis.ir/v1

# Optional fallbacks
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- Telegram ----------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=netai_telegram

# ---------- Bale ----------
BALE_BOT_TOKEN=

# ---------- Soroush (via SoroPy) ----------
SOROUSYH_DEFAULT_BACKEND=websocket

# ---------- Email ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
EMAIL_USER=
EMAIL_PASSWORD=

# ---------- YouTube ----------
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_SECRETS_FILE=

# ---------- Security ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
